{
  "manifest_version": 3,
  "name": "Behance Project Image Downloader",
  "version": "1.5.0",
  "description": "Pick images from a Behance project and save them in order, at full size.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": [
    "https://*.behance.net/*"
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_title": "Download Behance project images",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
